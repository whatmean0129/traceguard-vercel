# TraceGuard-Vercel-Repo — 仅供 Vercel 部署的最小运行集
# 与 .vercelignore 的排除口径对齐，防止误提交实验数据/真实图片/密钥/临时产物。

# 环境变量、密钥与凭据
.env
.env.*
*.key
*.pem
*.p12
*.pfx
credentials*
secrets*

# Python 缓存与虚拟环境
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
env/

# Vercel / 编辑器 / 系统产物
.vercel/
.DS_Store
Thumbs.db

# 实验数据、历史结果、报告、真实图片（严禁进入部署仓库）
results.json
phase1_backup/
phase2_results.*
phase3_results.*
*.csv
*.jsonl
*.log
*.png
*.jpg
*.jpeg
*.gif
*.bmp
*.webp
*.zip
*.rar
*.7z

# 非部署目录
data/
docs/
team/
webapp/docs/
webapp/logs/
webapp/output/
webapp/uploads/
webapp/evidence/
